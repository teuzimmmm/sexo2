@@ -10,12 +10,55 @@ EXTERN_C IMAGE_DOS_HEADER __ImageBase;
 #include <libgen.h>
 #endif
 
+#if OS_WIN
+// SEXO2: the app shares its config.ini with this core (General/disabled, General/loaderpath).
+static bool env_path(const wchar_t *name, std::wstring &out)
+{
+    wchar_t buf[2048];
+    DWORD n = GetEnvironmentVariableW(name, buf, _countof(buf));
+    if (n == 0 || n >= _countof(buf))
+        return false;
+    out.assign(buf, n);
+    return true;
+}
+
+path config::ini_path()
+{
+    std::wstring value;
+    if (env_path(L"SEXO2_CONFIG_PATH", value) || env_path(L"ROSE_CONFIG_PATH", value))
+        return value;
+    if (env_path(L"LOCALAPPDATA", value))
+        return path(value) / L"Rose" / L"config.ini";
+    return path();
+}
+
+static std::wstring ini_value(const wchar_t *key)
+{
+    wchar_t buf[2048]{};
+    auto ini = config::ini_path().wstring();
+    if (ini.empty())
+        return L"";
+    GetPrivateProfileStringW(L"General", key, L"", buf, _countof(buf), ini.c_str());
+    return buf;
+}
+
+bool config::hook_enabled()
+{
+    return ini_value(L"disabled") == L"0";
+}
+#endif
+
 path config::loader_dir()
 {
 #if OS_WIN
     static std::wstring path;
     if (path.empty())
     {
+        // SEXO2: the app tells where the loader (config, plugins, datastore) lives.
+        auto fromIni = ini_value(L"loaderpath");
+        if (!fromIni.empty())
+            return path = fromIni;
+
         // Get this dll path.
         WCHAR thisPath[2048];
         GetModuleFileNameW((HINSTANCE)&__ImageBase, thisPath, ARRAYSIZE(thisPath) - 1);
